{
  "entity": {
    "binary_sensor": {
      "gateway_connected": {
        "default": "mdi:lan-connect",
        "state": {
          "off": "mdi:lan-disconnect"
        }
      }
    },
    "select": {
      "gateway_repeater": {
        "default": "mdi:repeat-off",
        "state": {
          "off": "mdi:repeat-off",
          "level_1": "mdi:repeat-once",
          "level_2": "mdi:repeat"
        }
      }
    },
    "sensor": {
      "window_handle": {
        "default": "mdi:window-closed-variant",
        "state": {
          "open": "mdi:window-open-variant",
          "tilt": "mdi:window-open",
          "closed": "mdi:window-closed-variant"
        }
      },
      "d5_contact": {
        "default": "mdi:door",
        "state": {
          "open": "mdi:door-open",
          "closed": "mdi:door-closed"
        }
      },
      "radio_rssi": {
        "default": "mdi:signal-cellular-outline",
        "range": {
          "-120": "mdi:signal-cellular-outline",
          "-90": "mdi:signal-cellular-1",
          "-75": "mdi:signal-cellular-2",
          "-60": "mdi:signal-cellular-3"
        }
      },
      "radio_last_seen": {
        "default": "mdi:clock-check-outline"
      },
      "radio_repeater_count": {
        "default": "mdi:repeat"
      },
      "gateway_received_telegrams": {
        "default": "mdi:radio-tower"
      },
      "gateway_last_telegram": {
        "default": "mdi:clock-outline"
      },
      "gateway_base_id": {
        "default": "mdi:identifier"
      }
    }
  }
}
