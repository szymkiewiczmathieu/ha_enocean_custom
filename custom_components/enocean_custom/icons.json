{
  "entity": {
    "binary_sensor": {
      "gateway_connected": {
        "default": "mdi:lan-connect",
        "state": {
          "off": "mdi:lan-disconnect"
        }
      }
    },
    "select": {
      "gateway_repeater": {
        "default": "mdi:repeat-off",
        "state": {
          "off": "mdi:repeat-off",
          "level_1": "mdi:repeat-once",
          "level_2": "mdi:repeat"
        }
      }
    },
    "sensor": {
      "window_handle": {
        "default": "mdi:window-closed-variant",
        "state": {
          "open": "mdi:window-open-variant",
          "tilt": "mdi:window-open",
          "closed": "mdi:window-closed-variant"
        }
      },
      "d5_contact": {
        "default": "mdi:door",
        "state": {
          "open": "mdi:door-open",
          "closed": "mdi:door-closed"
        }
      },
      "d2_14_30_energy_storage": {
        "default": "mdi:battery",
        "state": {
          "high": "mdi:battery",
          "medium": "mdi:battery-50",
          "low": "mdi:battery-20",
          "critical": "mdi:battery-alert"
        }
      },
      "d2_14_30_comfort": {
        "default": "mdi:home-thermometer-outline",
        "state": {
          "good": "mdi:emoticon-happy-outline",
          "medium": "mdi:emoticon-neutral-outline",
          "bad": "mdi:emoticon-sad-outline",
          "error": "mdi:alert-circle-outline"
        }
      },
      "d2_14_30_air_quality": {
        "default": "mdi:air-filter",
        "state": {
          "optimal": "mdi:check-circle-outline",
          "dry": "mdi:water-off-outline",
          "humidity_high": "mdi:water-percent",
          "temperature_humidity_high": "mdi:thermometer-water",
          "error": "mdi:alert-circle-outline"
        }
      },
      "d2_14_30_maintenance_weeks": {
        "default": "mdi:calendar-clock"
      },
      "d2_14_30_remaining_life": {
        "default": "mdi:calendar-end"
      },
      "radio_rssi": {
        "default": "mdi:signal-cellular-outline",
        "range": {
          "-120": "mdi:signal-cellular-outline",
          "-90": "mdi:signal-cellular-1",
          "-75": "mdi:signal-cellular-2",
          "-60": "mdi:signal-cellular-3"
        }
      },
      "radio_last_seen": {
        "default": "mdi:clock-check-outline"
      },
      "radio_repeater_count": {
        "default": "mdi:repeat"
      },
      "gateway_received_telegrams": {
        "default": "mdi:radio-tower"
      },
      "gateway_last_telegram": {
        "default": "mdi:clock-outline"
      },
      "gateway_base_id": {
        "default": "mdi:identifier"
      }
    }
  }
}
